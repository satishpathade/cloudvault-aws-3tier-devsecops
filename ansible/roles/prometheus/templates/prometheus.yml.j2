global:
  scrape_interval: 15s

scrape_configs:

  - job_name: "node-exporter"

    static_configs:
      - targets:
{% for host in groups['cicd'] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}

      - targets:
{% for host in groups['web'] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}

      - targets:
{% for host in groups['app'] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}